# Token bot lấy ở https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# (Tuỳ chọn) ID server để đăng ký slash command ngay lập tức. Bỏ trống = đăng ký global (mất tới ~1 giờ)
GUILD_ID=
# (Tuỳ chọn) ID Discord của bạn - có toàn quyền duyệt dữ liệu trái ác quỷ ở mọi server
BOT_OWNER_ID=
# (Khuyên dùng trên Render) MongoDB Atlas free để không mất dữ liệu khi Render restart
MONGODB_URI=
MONGODB_DB=gpo_tts_bot
# Render tự cấp PORT, chạy local thì mặc định 3000
PORT=3000

# ---- Giọng đọc ElevenLabs (giọng Adam) ----
# Lấy key ở https://elevenlabs.io/app/settings/api-keys . Bỏ trống = dùng giọng Google miễn phí
ELEVENLABS_API_KEY=
# (Tuỳ chọn) Model hỗ trợ tiếng Việt: eleven_flash_v2_5 (nhanh, rẻ) hoặc eleven_turbo_v2_5
ELEVENLABS_MODEL=eleven_flash_v2_5
# (Tuỳ chọn) Voice ID riêng cho từng ngôn ngữ, mặc định là Adam (pNInz6obpgDQGcFmaJgB)
ELEVENLABS_VOICE_VI=
ELEVENLABS_VOICE_EN=
# (Tuỳ chọn) Chỉnh tông giọng từng ngôn ngữ: STABILITY/SIMILARITY/STYLE (0-1), SPEED (0.7-1.2)
# ELEVENLABS_SPEED_VI=1.0
# ELEVENLABS_STABILITY_EN=0.4
# ELEVENLABS_STYLE_EN=0.15
# (Tuỳ chọn) Số request ElevenLabs chạy cùng lúc (gói free nên để 2)
# ELEVENLABS_CONCURRENCY=2

